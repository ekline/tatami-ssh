# Single source of truth for fuzzing toolchain versions.
# Consumed by scripts/fuzz.sh and .github/workflows/fuzz.yml (sh syntax, KEY=VALUE).
#
# The production MSRV (1.85) and stable CI are unaffected. Nothing here
# installs or changes a global toolchain.

# Dated nightly used for libFuzzer builds with AddressSanitizer in CI.
FUZZ_NIGHTLY=nightly-2026-09-01
# cargo-fuzz release verified with that nightly.
CARGO_FUZZ_VERSION=0.13.1
# Supported fuzzing host.
FUZZ_HOST_TRIPLE=x86_64-unknown-linux-gnu
# libFuzzer defaults, overridable per invocation.
FUZZ_TIMEOUT_SECS=2
FUZZ_RSS_LIMIT_MB=1024
FUZZ_PR_SECONDS=20
FUZZ_SCHEDULED_SECONDS=300
